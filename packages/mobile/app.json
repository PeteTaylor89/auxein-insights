{
  "expo": {
    "name": "Auxein Grow",
    "slug": "auxein-grow",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B6830"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.nz.auxein.grow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Auxein Grow uses your location to track field work and record GPS data for tasks.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Auxein Grow uses your location in the background to continue tracking field work when the app is minimised.",
        "NSLocationAlwaysUsageDescription": "Auxein Grow uses your location in the background to continue tracking field work when the app is minimised.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B6830"
      },
      "edgeToEdgeEnabled": true,
      "package": "co.nz.auxein.grow",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Auxein Grow uses your location in the background to continue tracking field work when the app is minimised.",
          "locationWhenInUsePermission": "Auxein Grow uses your location to track field work and record GPS data for tasks.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://192.168.1.144:8000/api",
      "eas": {
        "projectId": "f1dc68ac-bef9-4ad7-a15a-fabca5ccf24f"
      }
    },
    "owner": "auxein"
  }
}
