{
  "expo": {
    "name": "Auxein Grow",
    "slug": "auxein-grow",
    "version": "0.2.1",
    "scheme": "auxeingrow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f1dc68ac-bef9-4ad7-a15a-fabca5ccf24f",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B6830"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.co.auxein.grow",
      "buildNumber": "10",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Auxein Grow uses your location to show your position on the vineyard map and to geotag observations, incidents and site check-ins as you record them.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B6830"
      },
      "edgeToEdgeEnabled": true,
      "package": "nz.co.auxein.grow",
      "versionCode": 10,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Auxein Grow uses your location to show your position on the vineyard map and to geotag observations, incidents and site check-ins as you record them.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-task-manager"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://api.auxein.co.nz/api",
      "eas": {
        "projectId": "f1dc68ac-bef9-4ad7-a15a-fabca5ccf24f"
      }
    },
    "owner": "auxein"
  }
}
