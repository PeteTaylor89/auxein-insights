# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# CNG: android/ and ios/ are generated by `expo prebuild` and are NOT tracked.
# They must stay git-ignored. @expo/fingerprint decides managed vs bare by asking
# whether android/app/build.gradle exists AND is un-ignored, so an un-ignored
# native dir flips the EAS builder to "bare" AFTER it prebuilds. It then hashes
# android/ instead of the config plugins, the runtimeVersion no longer matches the
# one eas-cli computed here, and the build dies in Configure expo-updates.
/android
/ios
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
