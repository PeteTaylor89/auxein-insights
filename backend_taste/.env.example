# backend_taste local dev env — copy to backend_taste/.env
# Shared with the main API: SECRET_KEY + ALGORITHM MUST match so the public JWT validates.
ENV=local

# Point at the SAME Postgres the main API uses; the taste schema lives inside it.
# (Local dev DB, or the shared RDS.) Schema `taste` is created by the migration.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auxein_db

# F1 — Taste signs its OWN tokens. This MUST NOT equal the main API's SECRET_KEY;
# the service refuses to boot outside local if it does. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TASTE_SECRET_KEY=replace-with-a-secret-unique-to-taste
ALGORITHM=HS256
TASTE_ACCESS_TOKEN_MINUTES=60
TASTE_REFRESH_TOKEN_DAYS=60

# Cutover window only: also accept the old Insights public_access token and
# resolve it through users.external_auth_id. Turn off once the SPA signs in
# against Taste, then delete SECRET_KEY below with it.
TASTE_ACCEPT_LEGACY_TOKEN=false
SECRET_KEY=the-main-api-secret-ONLY-while-the-line-above-is-true

# S3 (P9 photo presign) — optional until photos sync.
# UPLOADS_S3_BUCKET=
# UPLOADS_S3_REGION=ap-southeast-2

# --- Email (F1) --------------------------------------------------------------
# SMTP, matching the main API's variable names so the same credentials and
# verified sender work here. SEND_EMAILS defaults to false: with it off the
# message is LOGGED instead of sent, which is how you get the link locally.
SEND_EMAILS=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Auxein Taste
SMTP_TIMEOUT_SECONDS=10

# Where the links in those emails point (the SPA owns /verify and /reset).
TASTE_APP_URL=http://localhost:5175

# Leave FALSE until a real send has been confirmed from the deployed
# environment. Turning it on before then locks out everyone whose mail does not
# arrive, and there is no way back in without a working reset email.
TASTE_REQUIRE_VERIFIED_EMAIL=false
