# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.venv/
.env

# Uploads (keep empty dirs tracked)
uploads/
!uploads/.gitkeep
backend/uploads/
!backend/uploads/.gitkeep
backend/data/
# Database backups (large / sensitive)
*.sql
vineyard_backup.sql
vineyard_data.sql
vineyard_schema.sql

# Ingestion probe dumps (regenerable via ingestion/scripts/probe_hilltop.py)
ingestion/scripts/probes/*.json
# EXCEPTIONS: Waikato and Taranaki are NOT regenerable. Their WAFs (Incapsula and
# Cloudflare) reject scripted clients, so there is no probe script that can rebuild
# these — they were captured by hand through a real browser. Losing them means
# redoing that by hand, so they are tracked.
!ingestion/scripts/probes/waikato_all.json
!ingestion/scripts/probes/taranaki_all.json
# Bay of Plenty is regenerable in principle (seed_boprc_from_sos.py --refresh) but ONLY
# from the ingestion box: BoP's SOS server is IP-allowlisted, so no other machine —
# including a dev workstation — can rebuild it. Tracked for the same reason as the two
# above.
!ingestion/scripts/probes/boprc_sos.json
# NCEI's GHCN-Daily station inventory, cached by scripts/crosswalk_ghcnd.py.
# 11 MB, global, and re-fetched automatically when absent.
ingestion/scripts/probes/ghcnd-stations.txt

# Node modules
node_modules/
frontend/node_modules/

# Next.js build output
.next/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local env variants (if any)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Mobile store credentials (NEVER commit)
packages/mobile/auxein-gro-play-be8c6a8059a4.json
packages/mobile/*.keystore
packages/mobile/*.p8
packages/mobile/AuthKey_*.p8

# Interpolation grids — the national 500 m grid is 73 MB, too big for git history.
# It is a production input, not a test fixture: keep it in S3
# (s3://auxein-climate-surfaces/grids/) and fetch at run time.
# VCDN_5km.csv (372 KB) IS committed — the parity suite needs it.
backend/models/example data/VCDN_500m.csv

# Scratch working directory — ad-hoc scripts, DB extracts, and the local
# climate-surface output. The history backfill writes ~12 GB of COGs under
# scratchpad/climate_history/, and demo surfaces under scratchpad/demo_surfaces/.
# None of it belongs in git history; the surfaces belong in
# s3://auxein-climate-surfaces and are reproducible from the scripts.
scratchpad/
